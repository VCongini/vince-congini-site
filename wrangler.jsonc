{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vince-congini-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/video/*"],
    "not_found_handling": "404-page"
  }
}
