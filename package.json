{
  "name": "vince-congini-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sass:build": "sass src/assets/styles/main.scss:src/assets/styles/main.css --style=compressed",
    "sass:watch": "sass src/assets/styles/main.scss:src/assets/styles/main.css --watch",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "build": "npm run sass:build && npm run resume:pdf",
    "dev": "concurrently \"npm run sass:watch\" \"npx serve src -l 3000\"",
    "deploy": "npm run build && wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "sass": "^1.77.0",
    "wrangler": "^4.87.0"
  }
}
